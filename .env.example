# Server
PORT=4000

# SQLite database file location
DATABASE_PATH=./data/open-audio.db

# Directory for uploaded audio + cover files
UPLOAD_DIR=./uploads

# Secret used to sign auth tokens. Generated automatically by `npm run setup`.
JWT_SECRET=change-me

# Key that authorizes a full server removal. The CLI uses it to request a
# removal; the owner must enter the same key in the admin panel to confirm.
# Generated automatically by `npm run setup` (or `npm run admin removal-key`).
REMOVAL_KEY=

# Owner account created by `npm run setup`. The owner has full rights
# (track deletion, approval of delete requests, admin role changes, removal).
# Leave empty to be prompted. ADMIN_* vars are accepted as fallback aliases.
OWNER_USERNAME=owner
OWNER_PASSWORD=
OWNER_EMAIL=

# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=http://localhost:4000

# Security
# Set COOKIE_SECURE=1 to force the auth cookie over HTTPS only (production).
# Defaults to ON in production, OFF in development.
COOKIE_SECURE=
# Set TRUST_PROXY=1 when running behind a trusted proxy/load balancer so the
# real client IP (X-Forwarded-For) is used for rate limiting. Defaults to ON in production.
TRUST_PROXY=
# Set HELMET_CSP=1 to enable a strict Content-Security-Policy via helmet.
HELMET_CSP=

# Rate limiting (per IP). Window in ms, then max requests per window.
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20

# SoundCloud import (Studio). Binary must be reachable; defaults to 'yt-dlp' on PATH.
# Timeout per yt-dlp invocation in seconds (default 180).
YTDLP_PATH=
YTDLP_TIMEOUT_S=180
