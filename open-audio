#!/usr/bin/env bash
#
# open-audio — project management system utility
#
# Manages the application lifecycle on Linux: install, start, stop, update,
# configure, backup/restore, removal. Supports two deployment modes:
#   native  — runs directly on the host (Node + systemd or nohup)
#   docker  — runs in a container (image built locally)
#
# The utility complements the app-level scripts (npm run setup / npm run admin),
# adding exactly the system layer: service, process, volumes, env, statuses.
#
# Usage:  ./open-audio <command> [options]
#   install               install dependencies/image and (optionally) the service
#   start                 start
#   stop                  stop
#   restart               restart
#   status                status + health
#   health                check /api/health
#   logs [--follow|-f]    show logs
#   config ...            manage .env (list|get|set|edit|secret|removal-key)
#   update                update code/image and restart
#   backup [dir]          back up the DB + uploads (via the admin CLI)
#   restore <dir>         restore from a backup
#   admin <args...>       forward to the admin CLI
#   uninstall [--purge]   remove service/container (--purge deletes data)
#   remove [--yes] [reason]  full server teardown (application removal flow)
#   mode <native|docker>  switch deployment mode
#   self-install          symlink into /usr/local/bin/open-audio
#   version               utility version
#   help                  help
#
set -euo pipefail

PROG="open-audio"
VERSION="1.0.0"

# --- locations ------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
STATE_FILE="$PROJECT_DIR/.open-audio-state"
ENV_FILE="$PROJECT_DIR/.env"
LOG_DIR="$PROJECT_DIR/logs"
LOG_FILE="$LOG_DIR/server.log"
PID_FILE="$PROJECT_DIR/.open-audio.pid"
DOCKER_ENV="$PROJECT_DIR/.open-audio.docker.env"
SYSTEMD_UNIT="/etc/systemd/system/open-audio.service"

DEFAULT_PORT=4000
DEFAULT_DATA_DIR="$PROJECT_DIR/data"

# --- state (overridden by STATE_FILE) -------------------------------------
MODE="native"
PORT="$DEFAULT_PORT"
DATA_DIR="$DEFAULT_DATA_DIR"
SERVICE="open-audio"
IMAGE="open-audio:latest"
CONTAINER="open-audio"
VOLUME="open-audio-data"

# --- colors ---------------------------------------------------------------
if [ -t 1 ]; then
  C_R=$'\033[31m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_B=$'\033[34m'; C_RST=$'\033[0m'
else
  C_R=""; C_G=""; C_Y=""; C_B=""; C_RST=""
fi

info()  { printf '%s•%s %s\n' "$C_G" "$C_RST" "$*"; }
warn()  { printf '%s!%s %s\n' "$C_Y" "$C_RST" "$*"; }
err()   { printf '%s✗%s %s\n' "$C_R" "$C_RST" "$*" >&2; }
die()   { err "$*"; exit 1; }

# ---------------------------------------------------------------------------
# utilities
# ---------------------------------------------------------------------------
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "required command: $1"; }

load_state() {
  # defaults are set above; the state file only overrides them
  [ -f "$STATE_FILE" ] && source "$STATE_FILE" || true
  # In native mode the server reads PORT from .env — make it the source of
  # truth for status/health, otherwise they diverge after `config set PORT`.
  if [ "${MODE:-native}" != "docker" ]; then
    local p; p="$(env_get PORT 2>/dev/null || true)"
    [ -n "$p" ] && PORT="$p"
  fi
}

guard_docker() { [ "${MODE:-native}" = "docker" ] && need_cmd docker || true; }

save_state() {
  cat > "$STATE_FILE" <<EOF
# generated by the open-audio utility — do not edit manually
MODE="$MODE"
PORT="$PORT"
DATA_DIR="$DATA_DIR"
SERVICE="$SERVICE"
IMAGE="$IMAGE"
CONTAINER="$CONTAINER"
VOLUME="$VOLUME"
EOF
}

# Read a key's value from .env (without sourcing it into the current shell)
env_get() {
  local key="$1" f="${2:-$ENV_FILE}"
  [ -f "$f" ] || return 1
  local line
  line="$(grep -E "^${key}=" "$f" | tail -n1)" || return 1
  printf '%s' "${line#*=}"
}

# Set or update a key in .env
env_set() {
  local key="$1" val="$2" f="$ENV_FILE"
  mkdir -p "$(dirname "$f")"
  if [ -f "$f" ] && grep -qE "^${key}=" "$f"; then
    local esc; esc="$(printf '%s' "$val" | sed 's/[&/\]/\\&/g')"
    sed -i.bak -E "s|^${key}=.*|${key}=${esc}|" "$f" && rm -f "$f.bak"
  else
    printf '%s=%s\n' "$key" "$val" >> "$f"
  fi
}

mask() { [ -z "$1" ] && printf '(empty)' || printf '%.6s…%s' "$1" "$(printf '%s' "$1" | tail -c 4)"; }

require_root() { [ "$(id -u)" -eq 0 ] || die "this command needs root privileges (sudo)"; }

have_systemd() { [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; }

node_bin() { command -v node || die "node not found"; }
tsx_bin()  { [ -x "$PROJECT_DIR/node_modules/.bin/tsx" ] && printf '%s/node_modules/.bin/tsx' "$PROJECT_DIR" || die "tsx not found (run install)"; }

# ---------------------------------------------------------------------------
# health / application startup
# ---------------------------------------------------------------------------
health_url() { printf 'http://127.0.0.1:%s/api/health' "$PORT"; }

health_check() {
  local url; url="$(health_url)"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 5 "$url" >/dev/null 2>&1
  else
    node -e "fetch('$url').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
  fi
}

# ---- native ----
native_running() {
  if have_systemd && systemctl list-unit-files "${SERVICE}.service" >/dev/null 2>&1; then
    [ "$(systemctl is-active "${SERVICE}.service" 2>/dev/null)" = "active" ]
    return $?
  fi
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

native_start() {
  if native_running; then warn "already running"; return 0; fi
  mkdir -p "$LOG_DIR" "$DATA_DIR"
  local nb; nb="$(node_bin)"; local tb; tb="$(tsx_bin)"
  info "starting (native)…"
  nohup "$nb" "$tb" server/index.ts > "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 2
  if native_running; then info "started, PID $(cat "$PID_FILE")"; else err "failed to start — see $LOG_FILE"; return 1; fi
}

native_stop() {
  if have_systemd && systemctl list-unit-files "${SERVICE}.service" >/dev/null 2>&1; then
    systemctl stop "${SERVICE}.service" 2>/dev/null || true
  fi
  if [ -f "$PID_FILE" ]; then
    local pid; pid="$(cat "$PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
      info "stopping (PID $pid)…"
      kill "$pid" 2>/dev/null || true
      for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
}

# ---- docker ----
docker_env_file() {
  # build env for the container: pin paths inside the container (/data)
  # and pass secrets/owner through from the host .env
  cat > "$DOCKER_ENV" <<EOF
NODE_ENV=production
PORT=4000
DATABASE_PATH=/data/open-audio.db
UPLOAD_DIR=/data/uploads
COOKIE_SECURE=1
TRUST_PROXY=1
HELMET_CSP=${HELMET_CSP:-1}
EOF
  if [ -f "$ENV_FILE" ]; then
    grep -E '^(JWT_SECRET|REMOVAL_KEY|OWNER_USERNAME|OWNER_PASSWORD|OWNER_EMAIL|APP_URL)=' "$ENV_FILE" >> "$DOCKER_ENV" || true
  fi
  printf '%s' "$DOCKER_ENV"
}

docker_running() { docker ps -q --filter "name=^${CONTAINER}$" | grep -q . ; }

docker_run() {
  need_cmd docker
  local envf; envf="$(docker_env_file)"
  docker volume create "$VOLUME" >/dev/null
  docker run -d --name "$CONTAINER" --restart unless-stopped \
    -p "${PORT}:4000" \
    --env-file "$envf" \
    -v "${VOLUME}:/data" \
    "$IMAGE"
}

docker_start() {
  need_cmd docker
  if docker_running; then warn "already running"; return 0; fi
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    die "image $IMAGE is not built — run install"
  fi
  info "starting (docker)…"
  docker_run
  sleep 2
  docker_running && info "container $CONTAINER is running" || err "failed to start container"
}

docker_stop() {
  need_cmd docker
  docker stop "$CONTAINER" >/dev/null 2>&1 || true
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
}

# ---- shared wrappers ----
app_running() { [ "$MODE" = "docker" ] && docker_running || native_running; }

app_start() {
  if [ "$MODE" = "docker" ]; then docker_start; else native_start; fi
}
app_stop() {
  if [ "$MODE" = "docker" ]; then docker_stop; else native_stop; fi
}

# run the admin CLI (on the host or inside the container)
admin_cli() {
  if [ "$MODE" = "docker" ]; then
    need_cmd docker
    docker exec "$CONTAINER" npm run admin -- "$@"
  else
    need_cmd npm
    npm run admin -- "$@"
  fi
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------
cmd_install() {
  local use_service=0
  for a in "$@"; do [ "$a" = "--service" ] && use_service=1; done

  if [ "$MODE" = "docker" ]; then
    need_cmd docker
    info "mode: docker"
    # make sure .env exists (with secrets)
    if [ ! -f "$ENV_FILE" ]; then
      warn ".env not found — creating from the example and generating secrets"
      cp "${PROJECT_DIR}/.env.example" "$ENV_FILE"
      env_set JWT_SECRET "$(openssl rand -hex 32)"
      env_set REMOVAL_KEY "$(openssl rand -base64 24)"
    fi
    info "building image $IMAGE …"
    docker build -t "$IMAGE" "$PROJECT_DIR"
    docker_stop 2>/dev/null || true
    docker_run
    info "installed and running in docker"
    return 0
  fi

  # native
  info "mode: native"
  need_cmd node; need_cmd npm
  info "installing dependencies (npm ci)…"
  (cd "$PROJECT_DIR" && npm ci)
  info "initializing (npm run setup)…"
  (cd "$PROJECT_DIR" && npm run setup)
  mkdir -p "$DATA_DIR"

  if [ "$use_service" -eq 1 ]; then
    require_root
    install_systemd
  else
    info "systemd service not installed (no --service); starting via nohup"
  fi
  app_start
  info "installed"
}

install_systemd() {
  require_root
  local nb; nb="$(node_bin)"; local tb; tb="$(tsx_bin)"
  local run_user; run_user="$(logname 2>/dev/null || echo root)"
  info "installing systemd unit (user=$run_user)…"
  cat > "$SYSTEMD_UNIT" <<EOF
[Unit]
Description=Open Audio
After=network.target

[Service]
Type=simple
User=${run_user}
WorkingDirectory=${PROJECT_DIR}
Environment=NODE_ENV=production
EnvironmentFile=${ENV_FILE}
ExecStart=${nb} ${tb} server/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "${SERVICE}.service"
  systemctl restart "${SERVICE}.service"
  info "unit ${SERVICE}.service installed and started"
}

cmd_start()   { guard_docker; app_start; }
cmd_stop()    { guard_docker; app_stop; }
cmd_restart() { guard_docker; app_stop; sleep 1; app_start; }

cmd_status() {
  guard_docker
  echo "mode:         $MODE"
  echo "port:         $PORT"
  echo "data:         $DATA_DIR"
  if [ "$MODE" = "docker" ]; then echo "image:        $IMAGE"; echo "container:    $CONTAINER"; fi
  if app_running; then
    info "status:       running"
    if health_check; then info "health:       OK ($(health_url))"; else warn "health:       no response"; fi
  else
    warn "status:       not running"
  fi
}

cmd_health() { guard_docker; health_check && { info "OK"; } || { err "no response"; exit 1; }; }

cmd_logs() {
  guard_docker
  local follow=""; for a in "$@"; do [ "$a" = "--follow" ] || [ "$a" = "-f" ] && follow="-f"; done
  if [ "$MODE" = "docker" ]; then
    need_cmd docker; docker logs $follow "$CONTAINER"
  elif have_systemd && systemctl list-unit-files "${SERVICE}.service" >/dev/null 2>&1; then
    journalctl $follow -u "${SERVICE}.service"
  else
    [ -f "$LOG_FILE" ] && tail $follow -n 100 "$LOG_FILE" || err "log file not found"
  fi
}

cmd_config() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      [ -f "$ENV_FILE" ] || die ".env not found — run install"
      info "configuration (.env):"
      while IFS= read -r line; do
        [ -z "$line" ] && continue
        case "$line" in \#*) continue;; esac
        local k="${line%%=*}" v="${line#*=}"
        case "$k" in JWT_SECRET|REMOVAL_KEY) v="$(mask "$v")";; esac
        printf '  %-18s %s\n' "$k" "$v"
      done < "$ENV_FILE"
      ;;
    get)  [ -z "${1:-}" ] && die "usage: config get <KEY>"; v="$(env_get "$1")" || die "key not found"; case "$1" in JWT_SECRET|REMOVAL_KEY) v="$(mask "$v")";; esac; printf '%s\n' "$v";;
    set)
      [ -z "${1:-}" ] || [ -z "${2:-}" ] && die "usage: config set <KEY> <VALUE>"
      env_set "$1" "$2"
      info "set $1 (restart)"; cmd_restart
      ;;
    edit) ${EDITOR:-vi} "$ENV_FILE"; cmd_restart;;
    secret)
      info "rotating JWT_SECRET…"
      admin_cli secret
      info "done (restart)"; cmd_restart
      ;;
    removal-key)
      info "rotating REMOVAL_KEY…"
      admin_cli removal-key
      info "done (restart)"; cmd_restart
      ;;
    *) die "unknown config subcommand: $sub";;
  esac
}

cmd_update() {
  guard_docker
  info "updating…"
  if [ "$MODE" = "docker" ]; then
    need_cmd docker
    app_stop
    (cd "$PROJECT_DIR" && docker build -t "$IMAGE" .)
    docker_run
    info "updated (docker)"
    return 0
  fi
  # native
  if [ -d "$PROJECT_DIR/.git" ]; then
    (cd "$PROJECT_DIR" && git pull --ff-only || warn "git pull failed")
  fi
  (cd "$PROJECT_DIR" && npm ci && npm run build)
  cmd_restart
  info "updated (native)"
}

cmd_backup()   { admin_cli backup "${1:-}"; }
cmd_restore()  { [ -z "${1:-}" ] && die "usage: restore <dir>"; admin_cli restore "$1" --force; }
cmd_admin()    { admin_cli "$@"; }

cmd_uninstall() {
  guard_docker
  local purge=0
  for a in "$@"; do [ "$a" = "--purge" ] && purge=1; done
  info "removing deployment (mode $MODE)…"
  app_stop
  if have_systemd && [ -f "$SYSTEMD_UNIT" ]; then
    require_root
    systemctl disable "${SERVICE}.service" 2>/dev/null || true
    rm -f "$SYSTEMD_UNIT"
    systemctl daemon-reload
    info "systemd unit removed"
  fi
  if [ "$MODE" = "docker" ]; then
    need_cmd docker
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    docker volume rm "$VOLUME" >/dev/null 2>&1 || true
  fi
  if [ "$purge" -eq 1 ]; then
    require_root
    warn "full data wipe: $DATA_DIR, uploads, .env"
    rm -rf "$DATA_DIR" "$PROJECT_DIR/uploads" "$ENV_FILE" "$STATE_FILE" "$DOCKER_ENV" "$PID_FILE"
    info "data removed"
  else
    info "data kept in $DATA_DIR (use --purge to remove it)"
  fi
}

cmd_remove() {
  guard_docker
  local yes=0 reason=""
  for a in "$@"; do
    [ "$a" = "--yes" ] && yes=1 || reason="$a"
  done
  [ "$yes" -eq 1 ] || die "this command DESTROYS the server completely. Re-run with --yes."
  if ! app_running; then die "application is not running — start it before removal"; fi
  warn "initiating full server removal flow…"
  admin_cli remove-server "${reason}"
  cat <<EOF

${C_Y}Now confirm the removal in the admin panel:${C_RST}
  1. Open  http://<host>:$PORT/admin  with the owner account.
  2. In the removal-requests section confirm the removal by entering REMOVAL_KEY.
  3. The server will wipe the DB, uploads, dist and .env, then stop.

Or confirm via the API by passing REMOVAL_KEY to an owner session.
EOF
}

cmd_mode() {
  local m="${1:-}"; [ -z "$m" ] && die "usage: mode <native|docker>"
  [ "$m" = "native" ] || [ "$m" = "docker" ] || die "mode must be native or docker"
  # stop the current mode before switching
  app_stop 2>/dev/null || true
  MODE="$m"; save_state
  info "mode switched to: $MODE (saved in $STATE_FILE)"
}

cmd_self_install() {
  require_root
  local target="/usr/local/bin/open-audio"
  ln -sf "$SCRIPT_DIR/open-audio" "$target"
  chmod +x "$SCRIPT_DIR/open-audio"
  info "symlink created: $target"
}

cmd_version() { echo "$PROG $VERSION"; }

cmd_help() {
  sed -n '2,60p' "${BASH_SOURCE[0]}" | sed 's/^#\{1,2\} //' | sed '/^set -/q'
  echo
  echo "Current mode: $MODE   (change: $PROG mode <native|docker>)"
}

# ---------------------------------------------------------------------------
main() {
  load_state
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    install|start|stop|restart|status|health|logs|config|update|backup|restore|admin|uninstall|remove|mode|self-install|version|help|-h|--help)
      "cmd_$cmd" "$@" ;;
    *) err "unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

main "$@"
